# 锁定的第三方依赖版本与校验值（scripts/fetch-deps.sh 读取）。
# 升级时同时更新版本号与校验值，然后执行 scripts/build.sh 并真机回归。

# 鸿蒙版 Node.js：hqzing/ohos-node（官方源码 --dest-os=openharmony 交叉编译 + binary-sign-tool 自签名）
# 校验值取自 https://ohos-node.com/dist/v<ver>/SHASUMS256.txt，并与 GitHub Release 下载结果比对
NODE_VERSION=24.21.0
NODE_TARBALL=node-v24.21.0-openharmony-arm64.tar.xz
NODE_SHA256=8c4536b87514eafbbd833f08b6e4f55ed1e10c2d03c3f3ac1662c76be852b8d3
NODE_URL_GITHUB=https://github.com/hqzing/ohos-node/releases/download/v24.21.0/node-v24.21.0-openharmony-arm64.tar.xz
NODE_URL_MIRROR=https://ohos-node.com/dist/v24.21.0/node-v24.21.0-openharmony-arm64.tar.xz

# Kimi Code（npm 包，纯 JS）。校验值为 npm registry 的 dist.integrity
KIMI_CODE_VERSION=2.2.0
KIMI_CODE_INTEGRITY=sha512-I1w2l6JGYEUSwA1DTvYrw/kDJYjJQKHFON+RON61epDeTITvwpXoDn4Kgl4atA82RfwcsMp3KG6k8Yaoj6LT0A==

# HarmonyOS 版 Git：Harmonybrew/ohos-git 发布包
GIT_VERSION=2.55.0
GIT_TARBALL=git-2.55.0-ohos-arm64.tar.gz
GIT_SHA256=ca6a0247ca4bc45e52fe68d895653a84934917643aa448722dab1a476a7480b0
GIT_URL=https://github.com/Harmonybrew/ohos-git/releases/download/2.55.0/git-2.55.0-ohos-arm64.tar.gz

# HarmonyOS 版 Python：Harmonybrew/ohos-python 发布包；SHA256 与 GitHub Release API 的 digest 核对
PYTHON_VERSION=3.14.6
PYTHON_TARBALL=python-3.14.6-ohos-arm64.tar.gz
PYTHON_SHA256=8c9e2cb2bb795cb150b6e3980895d8c6fbaa7d0aeb3fa1ea47017ca901c631a2
PYTHON_URL=https://github.com/Harmonybrew/ohos-python/releases/download/3.14.6/python-3.14.6-ohos-arm64.tar.gz

# ripgrep：dsh-harmonyos 固定提交中的 musl 预编译 rg（只取 rg，不带其他 dsh 模块）
RG_BUILD=dsh-harmonyos-0.15.0
RG_URL=https://raw.githubusercontent.com/ystyle/dsh-harmonyos/8fefed1f474242cae6aaaa6f7fca1a46269659d5/prebuilt/rg
RG_SHA256=b78aac5a8bb964e700450927047888ec9bbd6df111ac1ea48b71c4362f9935ac
