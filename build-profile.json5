{
  "app": {
    // 签名配置不入库：由根目录 hvigorfile.ts 从 signing/default.local.json 注入（见 scripts/setup-signing.sh）
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      },
      {
        // 仅供本机 2in1 模拟器自测（scripts/emulator.sh）：模拟器镜像目前最高 HarmonyOS 6.1.1(24)，
        // 而 executableBinaryPaths 需要 API 24+。对外分发的仍是只支持 API 26 的 default 产品。
        "name": "emulator",
        "signingConfig": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "emulator"
          ]
        }
      ]
    }
  ]
}
