{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // 只面向鸿蒙PC：手机/平板不允许应用 fork/exec 包内二进制
    "deviceTypes": [
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "singleton",
        "exported": true,
        "supportWindowMode": [
          "fullscreen",
          "split",
          "floating"
        ],
        "minWindowWidth": 720,
        "minWindowHeight": 480,
        // 2in1 长时任务：窗口最小化时保持 kimi 服务进程不被冻结
        "backgroundModes": [
          "taskKeeping"
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        // 受限（ACL）权限：V8 JIT 需要可写可执行的匿名内存。随包 node 经 INHERIT_PARENT_PERMISSION 继承它。
        // 缺少它时 node 会在启动阶段 SIGTRAP；应用会提示检查签名，不能用无法联网的 jitless 模式代替。
        // 实测 2in1 的 normal 级 kernel.EXEMPT_ANONYMOUS_EXECUTABLE_MEMORY 不能替代它。
        // 调试 Profile 由 devecocli signature generate 自动带上该 ACL；上架需另行向 AGC 申请。
        "name": "ohos.permission.kernel.ALLOW_WRITABLE_CODE_MEMORY"
      },
      {
        // 2in1 专属（无需 ACL）：随包 bin 在其 .permission 节中声明它后，被拉起时继承本应用的 system_grant 权限。
        // bin 声明的权限不能超出本应用声明的权限，所以这里也要声明。
        "name": "ohos.permission.INHERIT_PARENT_PERMISSION"
      },
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:reason_background",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.FILE_ACCESS_PERSIST"
      },
      {
        "name": "ohos.permission.READ_WRITE_DOCUMENTS_DIRECTORY",
        "reason": "$string:reason_documents",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:reason_download",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      }
    ],
    // 解压模式：libs 安装时解压成真实文件（executableBinaryPaths 的前提）
    "compressNativeLibs": true,
    // 2in1「应用程序包集成 bin 文件」（API 24+）。bin 的权限写在它自己的 ELF .permission 节里：
    // 所有随包 bin 声明 INHERIT_PARENT_PERMISSION，被本应用拉起时继承 JIT、联网等 system_grant 权限。
    // node、python3、rg、git 及必要的 helper 由 scripts/stage-runtime.sh 加好 .permission 节后放到 entry/libs/arm64-v8a/
    "executableBinaryPaths": [
      {
        "path": "libs/arm64-v8a/node"
      },
      {
        "path": "libs/arm64-v8a/python3"
      },
      {
        "path": "libs/arm64-v8a/rg"
      },
      {
        "path": "libs/arm64-v8a/git"
      },
      {
        "path": "libs/arm64-v8a/git-upload-pack"
      },
      {
        "path": "libs/arm64-v8a/git-receive-pack"
      },
      {
        "path": "libs/arm64-v8a/git-upload-archive"
      },
      {
        "path": "libs/arm64-v8a/git-shell"
      },
      {
        "path": "libs/arm64-v8a/git-remote-https"
      }
    ]
  }
}
